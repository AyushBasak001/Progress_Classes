<%- include("partials/headerPublic.ejs", {pageCss: "/styles/public/enquiryPublic.css"}) %>

<h2 class="page-title">Enquiries</h2>

<div class="enquiry-page">
    <div class="enquiry-list">
        <% for (let index = 0; index < enquiryList.length; index++) { %>

        <div class="enquiry-card">

            <p class="enquiry-question">
            Q. <%= enquiryList[index].question %>
            </p>

            <% if (enquiryList[index].answer) { %>
            <p class="enquiry-answer">
                <strong>Answer:</strong> <%= enquiryList[index].answer %>
            </p>
            <% } else { %>
            <p class="empty-text">Answer pending</p>
            <% } %>

            <p class="enquiry-author">
            — <%= enquiryList[index].name || "Anonymous" %>
            </p>

        </div>

        <% } %>
    </div>

    <form class="enquiry-form" action="/enquiry" method="post">
        <h2>Ask a Question</h2>
        <input
        type="text"
        name="question"
        placeholder="Type your question here"
        required
        >
        <input
        type="text"
        name="name"
        placeholder="Your name (optional)"
        >
        <button type="submit">Submit Enquiry</button>
    </form>
</div>
    
<%- include("partials/footerPublic.ejs") %>