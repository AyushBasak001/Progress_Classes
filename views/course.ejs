<%- include("partials/headerPublic.ejs", {pageCss: "/styles/public/coursePublic.css"}) %>

    <h2 class="page-title">Courses</h2>

    <div class="content-list">
    <% for (let index = 0; index < courseList.length; index++) { %>
        <div class="course-card">
            <div class="course-header">
                <span class="course-id">ID: <%= courseList[index].id %></span>
                <h2 class="course-name"><%= courseList[index].name %></h2>
                <span class="course-level"><%= courseList[index].level %></span>
            </div>

            <details class="course-faculty">
                <summary>Assigned Faculty</summary>

                <% if (courseList[index].faculty.length === 0) { %>
                <p class="empty-text">No faculty assigned</p>
                <% } else { %>
                <ul class="faculty-list">
                    <% courseList[index].faculty.forEach(f => { %>
                    <li class="faculty-item">
                        <span class="faculty-id"><%= f.id %></span>
                        <span class="faculty-name">
                        <%= f.first_name %> <%= f.last_name %>
                        </span>
                    </li>
                    <% }) %>
                </ul>
                <% } %>
            </details>
        </div>
    <% } %>
    </div>

<%- include("partials/footerPublic.ejs") %>