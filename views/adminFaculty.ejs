<%- include("partials/headerAdmin.ejs") %>
<body>
  
<h1 class="admin-page-title">Admin · Faculties</h1>
<p class="admin-subtitle">Manage faculty records and course assignments</p>

<div class="admin-grid">

  <% for (let index = 0; index < facultyList.length; index++) { %>

  <form class="admin-card admin-faculty-card"
        data-faculty-id="<%= facultyList[index].id %>">

    <div class="admin-card-header">
      <span class="admin-id">ID: <%= facultyList[index].id %></span>
      <div class="admin-actions">
        <button type="button" class="btn-primary" onclick="updateFaculty(this)">Update</button>
        <button type="button" class="btn-danger" onclick="deleteFaculty('<%= facultyList[index].id %>')">Delete</button>
      </div>
    </div>

    <div class="admin-form-grid">
      <div>
        <label>First Name</label>
        <input type="text" name="fname" value="<%= facultyList[index].first_name %>">
      </div>

      <div>
        <label>Last Name</label>
        <input type="text" name="lname" value="<%= facultyList[index].last_name %>">
      </div>

      <div>
        <label>Qualification</label>
        <input type="text" name="qualification" value="<%= facultyList[index].qualification %>">
      </div>

      <div>
        <label>Date Joined</label>
        <input
          type="date"
          name="dateJoined"
          value="<%= facultyList[index].date_joined ? facultyList[index].date_joined.toISOString().split('T')[0] : '' %>"
        >
      </div>
    </div>

    <details class="admin-details">
      <summary>Assigned Courses</summary>

      <% if (facultyList[index].courses.length === 0) { %>
        <p class="empty-text">No courses assigned</p>
      <% } else { %>
        <ul class="admin-list">
          <% facultyList[index].courses.forEach(c => { %>
            <li><strong><%= c.id %></strong> — <%= c.name %> (<%= c.level %>)</li>
          <% }) %>
        </ul>
      <% } %>
    </details>

    <div class="admin-inline-actions">
      <input type="text" name="courseID" placeholder="Course ID">
      <button type="button" data-mode="course-to-faculty" class="btn-secondary" onclick="addCourseToFaculty(this)">Add</button>
      <button type="button" data-mode="course-to-faculty" class="btn-warning" onclick="deleteCourseFromFaculty(this)">Remove</button>
    </div>

  </form>

  <% } %>

  <!-- Add Faculty -->
  <form class="admin-card admin-add-card" action="/admin/faculty" method="post">
    <h3>Add New Faculty</h3>

    <div class="admin-form-grid">
      <input type="text" name="id" placeholder="Faculty ID" required>
      <input type="text" name="fname" placeholder="First Name" required>
      <input type="text" name="lname" placeholder="Last Name" required>
      <input type="text" name="qualification" placeholder="Qualification" required>
      <input type="date" name="dateJoined" required>
    </div>

    <button type="submit" class="btn-primary">Add Faculty</button>
  </form>

</div>

<%- include("partials/footerAdmin.ejs") %>