<%- include("partials/adminHeader.ejs") %>

<h1>Admin Faculties</h1>
<p>Here are the faculties:</p>
<div class="faculty-container">
    <% for( let index = 0; index < facultyList.length; index++ ) { %>
    <form class="faculty-tab">
        <div>
            <label>Faculty ID:</label>
            <input type="text" name="facultyID" value="<%= facultyList[index].id %>" readonly>
        </div>
        <div>
            <label>First Name:</label>
            <input type="text" name="fname" placeholder="First Name" value="<%= facultyList[index].first_name %>">
        </div>
        <div>
            <label>Last Name:</label>
            <input type="text" name="lname" placeholder="Last Name" value="<%= facultyList[index].last_name %>">
        </div>
        <div>
            <label>Qualification:</label>
            <input type="text" name="qualification" placeholder="Qualification" value="<%= facultyList[index].qualification %>">
        </div>
        <div>
            <label>dateJoined:</label>
            <input type="date" name="dateJoined" value="<%= facultyList[index].date_joined ? facultyList[index].date_joined.toISOString().split('T')[0] : '' %>">
        </div>
        <!-- Buttons calling different methods -->
        <div>
            <button type="button" onclick="updateFaculty(this)">Update Faculty</button>
            <button type="button" onclick="deleteFaculty('<%= facultyList[index].id %>')">Delete Faculty</button>
        </div>
        <details class="course-dropdown">
            <summary>View Courses</summary>
            <% if (facultyList[index].courses.length === 0) { %>
                <p class="empty">No courses assigned</p>
            <% } else { %>
                <ul>
                <% facultyList[index].courses.forEach(c => { %>
                    <li><%= c.id %> => <%= c.name %> <%= c.level %></li>
                <% }) %>
                </ul>
            <% } %>
        </details>
        <div>
            <label>Course ID:</label>
            <input type="text" name="courseID" placeholder="Course ID">
        </div>
        <div>
            <button type="button" onclick="addF_C(this)">Add Course</button>
            <button type="button" onclick="deleteF_C(this)">Remove Course</button>
        </div>
    </form>
<% } %>
    <form class="faculty-tab" action="/admin/faculty" method="post">
        <div>
            <label>Faculty ID:</label>
            <input type="text" name="id" placeholder="Faculty ID" required>
        </div>
        <div>
            <label>First Name:</label>
            <input type="text" name="fname" placeholder="First Name" required>
        </div>
        <div>
            <label>Last Name:</label>
            <input type="text" name="lname" placeholder="Last Name" required>
        </div>
        <div>
            <label>Qualification:</label>
            <input type="text" name="qualification" placeholder="Qualification" required>
        </div>
        <div>
            <label>dateJoined:</label>
            <input type="date" name="dateJoined" required>
        </div>
        <button type="submit">Add Faculty</button>
    </form>

</div>

<script>

async function updateFaculty(btn) {
  const form = btn.closest("form");
  const id = form.querySelector("input[name='facultyID']").value;
  const fname = form.querySelector("input[name='fname']").value.trim();
  const lname = form.querySelector("input[name='lname']").value.trim();
  const qualification = form.querySelector("input[name='qualification']").value.trim();
  const dateJoined = form.querySelector("input[name='dateJoined']").value;

  const payload = {
    fname: fname,
    lname: lname,
    qualification: qualification,
    dateJoined: dateJoined
  };

  try {
    const res = await fetch(`/admin/faculty/${id}`, {
      method: "PATCH",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify(payload)
    });

    if (res.ok) {
      alert("Successfully updated faculty. Please reload the page.");
    } else {
      alert("Failed to Update faculty");
    }

  } catch (err) {
    console.error(err);
    alert("Server error");
  }
}

async function deleteFaculty(id) {
  if (!confirm("Are you sure you want to delete this faculty?")) return;

  try {
    const res = await fetch(`/admin/faculty/${id}`, {
      method: "DELETE",
      credentials: "same-origin"
    });

    if (res.ok) {
      alert("Successfully deleted faculty. Please reload the page.");
    } else {
      alert("Failed to delete faculty");
    }
  } catch (err) {
    console.error(err);
    alert("Server error");
  }
}

async function addF_C(btn){
  const form = btn.closest("form");
  const facultyID = form.querySelector("input[name='facultyID']").value;
  const courseID = form.querySelector("input[name='courseID']").value;

  if (!facultyID || !courseID) {
    alert("Faculty ID and Course ID are required");
    return;
  }

  try {
    const res = await fetch("/admin/faculty_course", {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        faculty_id: facultyID,
        course_id: courseID
      })
    });
    if (res.ok) {
      alert("Successfully added course. Please reload the page.");
    } else {
      alert("Failed to add course");
    }
  } catch (err) {
    console.error(err);
    alert("Server error");
  }
}

async function deleteF_C(btn){
  const form = btn.closest("form");
  const facultyID = form.querySelector("input[name='facultyID']").value;
  const courseID = form.querySelector("input[name='courseID']").value;

  if (!facultyID || !courseID) {
    alert("Faculty ID and Course ID are required");
    return;
  }

  try {
    const res = await fetch(`/admin/faculty/${facultyID}/courses/${courseID}`, {
      method: "DELETE",
      credentials: "same-origin"
    });
    if (res.ok) {
      alert("Successfully deleted course. Please reload the page.");
    } else {
      alert("Failed to delete course");
    }
  } catch (err) {
    console.error(err);
    alert("Server error");
  }
}

</script>

<%- include("partials/adminFooter.ejs") %>