<%- include("partials/headerAdmin.ejs", {pageCss: "/styles/admin/enquiryAdmin.css"}) %>
<body>
  
<h1 class="admin-page-title">Admin · Enquiries</h1>
<p class="admin-subtitle">Review, answer, and control public visibility</p>

<div class="admin-grid">

  <% for (let index = 0; index < enquiryList.length; index++) { %>

  <form class="admin-card admin-enquiry-card">

    <input type="hidden" name="id" value="<%= enquiryList[index].id %>">

    <div class="admin-card-header">
      <span class="admin-id">Enquiry #<%= enquiryList[index].id %></span>

      <div class="admin-actions">
        <button type="button" class="btn-primary" onclick="updateEnquiry(this)">Update</button>
        <button type="button" class="btn-danger" onclick="deleteEnquiry('<%= enquiryList[index].id %>')">Delete</button>
      </div>
    </div>

    <div class="admin-enquiry-block">
      <label>Question</label>
      <textarea readonly><%= enquiryList[index].question %></textarea>
    </div>

    <div class="admin-enquiry-block">
      <label>Answer</label>
      <textarea name="answer" placeholder="Write answer here..."><%= enquiryList[index].answer || "" %></textarea>
    </div>

    <div class="admin-meta-row">
      <div>
        <label>User</label>
        <input type="text" value="<%= enquiryList[index].name %>" readonly>
      </div>

      <label class="checkbox-label">
        <input type="checkbox" name="is_visible"
          <%= enquiryList[index].is_visible ? "checked" : "" %>>
        Visible to public
      </label>
    </div>

  </form>

  <% } %>

</div>

<%- include("partials/footerAdmin.ejs") %>