<%- include("partials/adminHeader.ejs") %>

<h1>Admin Enquiry</h1>
<p>Here are the enquiries:</p>
<div class="enquiry-container">
    <% for( let index = 0; index < enquiryList.length; index++ ) { %>
    <form class="enquiry-tab">
        <input type="hidden" name="id" value="<%= enquiryList[index].id %>">
        <div>
            <label>Question:</label>
            <input type="text" value="<%= enquiryList[index].question %>" readonly>
        </div>
        <div>
            <label>Answer:</label>
            <input type="text" name="answer" placeholder="Give answer" value="<%= enquiryList[index].answer %>">
        </div>
        <div>
            <label>User Name:</label>
            <input type="text" value="<%= enquiryList[index].name %>" readonly>
        </div>
        <div>
            <label>
                <input type="checkbox" id="isVisible" name="is_visible" <%= enquiryList[index].is_visible ? 'checked' : '' %>>
                Visible
            </label>
        </div>
        <!-- Buttons calling different methods -->
        <div>
            <button type="button" onclick="updateEnquiry(this)">Update</button>
            <button type="button" onclick="deleteEnquiry('<%= enquiryList[index].id %>')">Delete</button>
        </div>
    </form>
    <% } %>
</div>

<script>

async function updateEnquiry(btn) {
  const form = btn.closest("form");
  const id = form.querySelector("input[name='id']").value;
  const answer = form.querySelector("input[name='answer']").value.trim();
  const isVisible = form.querySelector("input[name='is_visible']").checked;

  const payload = {
    is_visible: isVisible
  };

  if (answer !== "") {
    payload.answer = answer;
  }

  try {
    const res = await fetch(`/admin/enquiry/${id}`, {
      method: "PATCH",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify(payload)
    });

    if (res.ok) {
      alert("Successfully updated enquiry. Please reload the page.");
    } else {
      alert("Failed to update Enquiry");
    }

  } catch (err) {
    console.error(err);
    alert("Server error");
  }
}

async function deleteEnquiry(id) {
  if (!confirm("Are you sure you want to delete this enquiry?")) return;

  try {
    const res = await fetch(`/admin/enquiry/${id}`, {
      method: "DELETE",
      credentials: "same-origin"
    });

    if (res.ok) {
      alert("Successfully deleted enquiry. Please reload the page.");
    } else {
      alert("Failed to delete enquiry");
    }
  } catch (err) {
    console.error(err);
    alert("Server error");
  }
}
</script>


<%- include("partials/adminFooter.ejs") %>