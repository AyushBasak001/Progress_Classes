<%- include("partials/headerAdmin.ejs", {pageCss: "/styles/admin/loginAdmin.css"}) %>

<body class="admin-login-body">

  <div class="admin-login-container">
    <h2 class="admin-login-title">Change Admin Password</h2>

    <form class="admin-login-form" action="/admin/changePassword" method="POST">

        <label for="password">Current Password</label>
        <input type="password" name="oldPassword" id="password" required 
            placeholder="Enter current admin password">

        <label for="password">New Password</label>
        <input type="password" name="newPassword" id="password" required 
            placeholder="Enter new admin password">
            
        <button type="submit">Login</button>

    </form>
  </div>
</body>
</html>