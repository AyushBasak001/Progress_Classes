<%- include("partials/headerPublic.ejs", {pageCss: "/styles/public/facultyPublic.css"}) %>

    <h2 class="page-title">Faculties</h2>

    <div class="content-list">
    <% for (let index = 0; index < facultyList.length; index++) { %>

        <div class="faculty-card">

        <div class="faculty-header">
            <span class="faculty-id">ID: <%= facultyList[index].id %></span>
            <h2 class="faculty-name">
            <%= facultyList[index].first_name %> <%= facultyList[index].last_name %>
            </h2>
            <span class="faculty-qualification">
            <%= facultyList[index].qualification %>
            </span>
        </div>

        <details class="faculty-courses">
            <summary>Assigned Courses</summary>

            <% if (facultyList[index].courses.length === 0) { %>
            <p class="empty-text">No courses assigned</p>
            <% } else { %>
            <ul class="course-list-inner">
                <% facultyList[index].courses.forEach(c => { %>
                <li class="course-item">
                    <span class="course-id"><%= c.id %></span>
                    <span class="course-name"><%= c.name %></span>
                    <span class="course-level"><%= c.level %></span>
                </li>
                <% }) %>
            </ul>
            <% } %>
        </details>
        </div>
    <% } %>
    </div>
    
<%- include("partials/footerPublic.ejs") %>