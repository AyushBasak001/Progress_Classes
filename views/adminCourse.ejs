<%- include("partials/headerAdmin.ejs") %>
<body>
    
<h1 class="admin-page-title">Admin · Courses</h1>
<p class="admin-subtitle">Manage courses and faculty assignments</p>

<div class="admin-grid">

  <% for (let index = 0; index < courseList.length; index++) { %>

  <form class="admin-card admin-course-card"
        data-course-id="<%= courseList[index].id %>">

    <div class="admin-card-header">
      <span class="admin-id">ID: <%= courseList[index].id %></span>
      <div class="admin-actions">
        <button type="button" class="btn-primary" onclick="updateCourse(this)">Update</button>
        <button type="button" class="btn-danger" onclick="deleteCourse('<%= courseList[index].id %>')">Delete</button>
      </div>
    </div>

    <div class="admin-form-grid">
      <div>
        <label>Course Name</label>
        <input type="text" name="name" value="<%= courseList[index].name %>">
      </div>

      <div>
        <label>Level</label>
        <input type="text" name="level" value="<%= courseList[index].level %>">
      </div>
    </div>

    <details class="admin-details">
      <summary>Assigned Faculty</summary>

      <% if (courseList[index].faculty.length === 0) { %>
        <p class="empty-text">No faculty assigned</p>
      <% } else { %>
        <ul class="admin-list">
          <% courseList[index].faculty.forEach(f => { %>
            <li>
              <strong><%= f.id %></strong> — <%= f.first_name %> <%= f.last_name %>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </details>

    <div class="admin-inline-actions">
      <input type="text" name="facultyID" placeholder="Faculty ID">
      <button type="button" class="btn-secondary" onclick="addFacultyToCourse(this)">Add</button>
      <button type="button" class="btn-warning" onclick="deleteFacultyFromCourse(this)">Remove</button>
    </div>

  </form>

  <% } %>

  <!-- Add Course -->
  <form class="admin-card admin-add-card" action="/admin/course" method="post">
    <h3>Add New Course</h3>

    <div class="admin-form-grid">
      <input type="text" name="id" placeholder="Course ID" required>
      <input type="text" name="name" placeholder="Course Name" required>
      <input type="text" name="level" placeholder="Course Level" required>
    </div>

    <button type="submit" class="btn-primary">Add Course</button>
  </form>

</div>

<%- include("partials/footerAdmin.ejs") %>