<%- include("partials/adminHeader.ejs") %>

<h1>Admin Courses</h1>
<p>Here are the courses:</p>
<div class="course-container">
    <% for( let index = 0; index < courseList.length; index++ ) { %>
    <form class="course-tab">
        <div>
            <label>Course ID:</label>
            <input type="text" name="courseID" value="<%= courseList[index].id %>" readonly>
        </div>
        <div>
            <label>Name:</label>
            <input type="text" name="name" placeholder="Course Name" value="<%= courseList[index].name %>">
        </div>
        <div>
            <label>Level:</label>
            <input type="text" name="level" placeholder="Course Level" value="<%= courseList[index].level %>">
        </div>
        <!-- Buttons calling different methods -->
        <div>
            <button type="button" onclick="updateCourse(this)">Update Course</button>
            <button type="button" onclick="deleteCourse('<%= courseList[index].id %>')">Delete Course</button>
        </div>
        <details class="faculty-dropdown">
            <summary>View Faculty</summary>
            <% if (courseList[index].faculty.length === 0) { %>
                <p class="empty">No faculty assigned</p>
            <% } else { %>
                <ul>
                <% courseList[index].faculty.forEach(f => { %>
                    <li><%= f.id %> => <%= f.first_name %> <%= f.last_name %></li>
                <% }) %>
                </ul>
            <% } %>
        </details>
        <div>
            <label>Faculty ID:</label>
            <input type="text" name="facultyID" placeholder="Faculty ID">
        </div>
        <div>
            <button type="button" onclick="addF_C(this)">Add Faculty</button>
            <button type="button" onclick="deleteF_C(this)">Remove Faculty</button>
        </div>
    </form>
<% } %>
    <form class="course-tab" action="/admin/course" method="post">
        <div>
            <label>Course ID:</label>
            <input type="text" name="id" placeholder="Course ID" required>
        </div>
        <div>
            <label>Name:</label>
            <input type="text" name="name" placeholder="Course Name" required>
        </div>
        <div>
            <label>Level:</label>
            <input type="text" name="level" placeholder="Course Level" required>
        </div>
        <div>
            <button type="submit">Add Course</button>
        </div>
    </form>

</div>

<script>
    
async function updateCourse(btn) {
  const form = btn.closest("form");
  const id = form.querySelector("input[name='courseID']").value;
  const name = form.querySelector("input[name='name']").value.trim();
  const level = form.querySelector("input[name='level']").value.trim();

  const payload = {
    name: name,
    level: level
  };

  try {
    const res = await fetch(`/admin/course/${id}`, {
      method: "PATCH",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify(payload)
    });

    if (res.ok) {
      alert("Successfully updated course. Please reload the page.");
    } else {
      alert("Failed to update Course");
    }

  } catch (err) {
    console.error(err);
    alert("Server error");
  }
}

async function deleteCourse(id) {
  if (!confirm("Are you sure you want to delete this course?")) return;

  try {
    const res = await fetch(`/admin/course/${id}`, {
      method: "DELETE",
      credentials: "same-origin"
    });

    if (res.ok) {
      alert("Successfully deleted course. Please reload the page.");
    } else {
      alert("Failed to delete course");
    }
  } catch (err) {
    console.error(err);
    alert("Server error");
  }
}

async function addF_C(btn){
  const form = btn.closest("form");
  const facultyID = form.querySelector("input[name='facultyID']").value;
  const courseID = form.querySelector("input[name='courseID']").value;

  if (!facultyID || !courseID) {
    alert("Faculty ID and Course ID are required");
    return;
  }

  try {
    const res = await fetch("/admin/faculty_course", {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        faculty_id: facultyID,
        course_id: courseID
      })
    });
    if (res.ok) {
      alert("Successfully added faculty. Please reload the page.");
    } else {
      alert("Failed to add faculty");
    }
  } catch (err) {
    console.error(err);
    alert("Server error");
  }
}

async function deleteF_C(btn){
  const form = btn.closest("form");
  const facultyID = form.querySelector("input[name='facultyID']").value;
  const courseID = form.querySelector("input[name='courseID']").value;

  if (!facultyID || !courseID) {
    alert("Faculty ID and Course ID are required");
    return;
  }

  try {
    const res = await fetch(`/admin/faculty/${facultyID}/courses/${courseID}`, {
      method: "DELETE",
      credentials: "same-origin"
    });
    if (res.ok) {
      alert("Successfully deleted faculty. Please reload the page.");
    } else {
      alert("Failed to delete faculty");
    }
  } catch (err) {
    console.error(err);
    alert("Server error");
  }
}

</script>

<%- include("partials/adminFooter.ejs") %>